---
import Layout from "../../layouts/Layout.astro";
import { getCollection } from "astro:content";

const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const fmt = new Intl.DateTimeFormat("zh-CN", { dateStyle: "medium" });
---

<Layout title="博客">
  <h1 class="text-3xl font-bold text-slate-900 dark:text-white">博客</h1>
  <p class="mt-2 text-slate-500 dark:text-slate-400">共 {posts.length} 篇文章</p>

  <ul class="mt-8 divide-y divide-slate-200 dark:divide-slate-800">
    {
      posts.map((post) => (
        <li class="py-5">
          <a href={`/blog/${post.id}`} class="group block">
            <h2 class="text-xl font-semibold text-slate-900 group-hover:text-sky-600 dark:text-white dark:group-hover:text-sky-400">
              {post.data.title}
            </h2>
            <div class="mt-1 flex flex-wrap items-center gap-3 text-sm text-slate-400">
              <time datetime={post.data.pubDate.toISOString()}>{fmt.format(post.data.pubDate)}</time>
              {post.data.tags.map((tag) => (
                <span class="rounded bg-slate-100 px-2 py-0.5 dark:bg-slate-800">{tag}</span>
              ))}
            </div>
            {post.data.description && (
              <p class="mt-2 text-slate-600 dark:text-slate-400">{post.data.description}</p>
            )}
          </a>
        </li>
      ))
    }
  </ul>
</Layout>
