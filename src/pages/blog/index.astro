---
import Layout from "../../layouts/Layout.astro";
import { getCollection } from "astro:content";

const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const fmt = new Intl.DateTimeFormat("zh-CN", { dateStyle: "medium" });
---

<Layout title="博客" container="default">
  <p class="font-mono text-xs uppercase tracking-[0.2em] text-slate-400 dark:text-slate-600">// blog</p>
  <h1 class="mt-3 font-mono text-3xl font-bold tracking-tight text-slate-900 dark:text-slate-50">
    $ ls /blog
  </h1>
  <p class="mt-3 font-mono text-sm text-slate-500 dark:text-slate-400">
    共 {posts.length} 篇 · 按发布时间倒序
  </p>

  <ul class="mt-10 divide-y divide-slate-300/70 border-y border-slate-300/70 dark:divide-slate-800 dark:border-slate-800">
    {
      posts.map((post) => (
        <li>
          <a href={`/blog/${post.id}`} class="group flex items-start gap-4 py-5 font-mono transition-colors hover:bg-slate-900/[0.03] dark:hover:bg-white/[0.04]">
            <span class="pt-1 text-slate-400 transition-transform group-hover:translate-x-1 group-hover:text-emerald-600 dark:text-slate-600 dark:group-hover:text-emerald-400">
              ▸
            </span>
            <div class="min-w-0 flex-1">
              <h2 class="text-lg font-semibold leading-snug text-slate-900 group-hover:text-emerald-700 dark:text-slate-100 dark:group-hover:text-emerald-300">
                {post.data.title}
              </h2>
              {post.data.description && (
                <p class="mt-1.5 text-sm leading-6 text-slate-500 dark:text-slate-400">
                  {post.data.description}
                </p>
              )}
              <p class="mt-2 flex flex-wrap items-center gap-x-3 gap-y-1 text-xs text-slate-400 dark:text-slate-600">
                <time datetime={post.data.pubDate.toISOString()}>{fmt.format(post.data.pubDate)}</time>
                {post.data.tags.map((tag) => (
                  <span>[{tag}]</span>
                ))}
              </p>
            </div>
          </a>
        </li>
      ))
    }
  </ul>
</Layout>
