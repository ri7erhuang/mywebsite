---
import Layout from "../layouts/Layout.astro";
import { BOOKMARKS } from "../data/bookmarks";
---

<Layout title="导航" description="我常去的网站和工具。">
  <p class="font-mono text-xs uppercase tracking-[0.2em] text-slate-400 dark:text-slate-600">// nav</p>
  <h1 class="mt-3 font-mono text-3xl font-bold tracking-tight text-slate-900 dark:text-slate-50">
    收藏清单
  </h1>
  <p class="mt-3 font-mono text-sm text-slate-500 dark:text-slate-400">
    只放我真实在用的入口，点开的都是新标签页。
  </p>

  <div class="mt-10 space-y-12">
    {
      BOOKMARKS.map((category) => (
        <section>
          <h2 class="font-mono text-xs uppercase tracking-[0.2em] text-slate-400 dark:text-slate-600">
            // {category.title}
          </h2>
          <ul class="mt-3 divide-y divide-slate-300/70 border-y border-slate-300/70 dark:divide-slate-800 dark:border-slate-800">
            {category.items.map((item) => (
              <li>
                <a
                  href={item.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="group flex items-baseline gap-3 py-4 font-mono transition-colors hover:bg-slate-900/[0.03] dark:hover:bg-white/[0.04]"
                >
                  <span class="text-slate-400 transition-transform group-hover:translate-x-1 group-hover:text-emerald-600 dark:text-slate-600 dark:group-hover:text-emerald-400">
                    ▸
                  </span>
                  <span class="min-w-44 shrink-0 font-semibold text-slate-900 dark:text-slate-100">
                    {item.name}
                  </span>
                  <span class="flex-1 text-sm text-slate-500 dark:text-slate-400">
                    {item.description}
                  </span>
                  <span class="hidden shrink-0 text-xs text-slate-400 md:inline dark:text-slate-600">
                    {new URL(item.url).hostname} ↗
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))
    }
  </div>
</Layout>
