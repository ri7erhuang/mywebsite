---
import ToolShell from "../../components/ToolShell.astro";
const areaCls =
  "h-72 w-full resize-y rounded-lg border border-slate-300 bg-white p-3 font-mono text-sm outline-none focus:border-sky-500 dark:border-slate-700 dark:bg-slate-900";
const btn = "rounded-lg px-4 py-2 text-sm font-medium transition";
---

<ToolShell title="JSON 格式化" description="格式化、压缩与校验 JSON。">
  <div class="flex flex-wrap gap-3">
    <button id="format-btn" class={`${btn} bg-sky-600 text-white hover:bg-sky-500`}>格式化</button>
    <button id="minify-btn" class={`${btn} border border-slate-300 hover:bg-slate-100 dark:border-slate-700 dark:hover:bg-slate-800`}>压缩</button>
    <button id="clear-btn" class={`${btn} border border-slate-300 hover:bg-slate-100 dark:border-slate-700 dark:hover:bg-slate-800`}>清空</button>
    <button id="copy-btn" class={`${btn} border border-slate-300 hover:bg-slate-100 dark:border-slate-700 dark:hover:bg-slate-800`}>复制结果</button>
  </div>

  <label class="mb-1.5 mt-6 block text-sm font-medium text-slate-700 dark:text-slate-300" for="json-io">
    输入 / 输出
  </label>
  <textarea id="json-io" class={areaCls} spellcheck="false" placeholder='{"hello": "world"}'></textarea>

  <p id="json-status" class="mt-3 text-sm text-slate-500 dark:text-slate-400"></p>
</ToolShell>

<script>
  const io = document.getElementById("json-io") as HTMLTextAreaElement;
  const status = document.getElementById("json-status")!;

  function setStatus(text: string, ok: boolean) {
    status.textContent = text;
    status.className = `mt-3 text-sm ${ok ? "text-emerald-600 dark:text-emerald-400" : "text-red-600 dark:text-red-400"}`;
  }

  function parse() {
    try {
      const value = JSON.parse(io.value);
      return { value, error: null as string | null };
    } catch (e) {
      return { value: null, error: (e as Error).message };
    }
  }

  document.getElementById("format-btn")?.addEventListener("click", () => {
    const { value, error } = parse();
    if (error) return setStatus(`解析失败：${error}`, false);
    io.value = JSON.stringify(value, null, 2);
    setStatus("格式化成功 ✓", true);
  });

  document.getElementById("minify-btn")?.addEventListener("click", () => {
    const { value, error } = parse();
    if (error) return setStatus(`解析失败：${error}`, false);
    io.value = JSON.stringify(value);
    setStatus("压缩成功 ✓", true);
  });

  document.getElementById("clear-btn")?.addEventListener("click", () => {
    io.value = "";
    setStatus("", true);
  });

  document.getElementById("copy-btn")?.addEventListener("click", async () => {
    await navigator.clipboard.writeText(io.value);
    setStatus("已复制到剪贴板 ✓", true);
  });
</script>
