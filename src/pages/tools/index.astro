---
import Layout from "../../layouts/Layout.astro";
import { TOOLS } from "../../data/tools";
---

<Layout title="工具" description="一些常用的在线小工具。">
  <p class="font-mono text-xs uppercase tracking-[0.2em] text-slate-400 dark:text-slate-600">// tools</p>
  <h1 class="mt-3 font-mono text-3xl font-bold tracking-tight text-slate-900 dark:text-slate-50">
    $ ls /tools
  </h1>
  <p class="mt-3 font-mono text-sm text-slate-500 dark:text-slate-400">
    {TOOLS.length} 个 · 全部在浏览器本地运行，数据不出这台设备
  </p>

  <ul class="mt-10 divide-y divide-slate-300/70 border-y border-slate-300/70 dark:divide-slate-800 dark:border-slate-800">
    {
      TOOLS.map((tool) => (
        <li>
          <a
            href={tool.href}
            class="group flex items-baseline gap-3 py-4 font-mono transition-colors hover:bg-slate-900/[0.03] dark:hover:bg-white/[0.04]"
          >
            <span class="text-slate-400 transition-transform group-hover:translate-x-1 group-hover:text-emerald-600 dark:text-slate-600 dark:group-hover:text-emerald-400">
              ▸
            </span>
            <span class="min-w-40 shrink-0 font-semibold text-slate-900 group-hover:text-emerald-700 dark:text-slate-100 dark:group-hover:text-emerald-300">
              {tool.name}
            </span>
            <span class="flex-1 text-sm text-slate-500 dark:text-slate-400">{tool.description}</span>
          </a>
        </li>
      ))
    }
  </ul>
</Layout>
