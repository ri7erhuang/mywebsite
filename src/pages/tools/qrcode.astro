---
import ToolShell from "../../components/ToolShell.astro";
const inputCls =
  "w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm outline-none focus:border-emerald-600 dark:border-slate-700 dark:bg-slate-900";
const labelCls = "mb-1.5 block text-sm font-medium text-slate-700 dark:text-slate-300";
---

<ToolShell title="二维码生成" description="把文本、网址或联系方式生成二维码，可下载 PNG。">
  <div class="grid gap-8 md:grid-cols-[1fr_auto]">
    <div class="space-y-4">
      <div>
        <label class={labelCls} for="qr-text">内容</label>
        <textarea
          id="qr-text"
          class="h-28 w-full resize-y rounded-lg border border-slate-300 bg-white p-3 text-sm outline-none focus:border-emerald-600 dark:border-slate-700 dark:bg-slate-900"
          placeholder="https://example.com">https://example.com</textarea>
      </div>
      <div class="grid grid-cols-3 gap-3">
        <div>
          <label class={labelCls} for="qr-size">尺寸</label>
          <input id="qr-size" type="number" min="128" max="1024" step="32" value="256" class={inputCls} />
        </div>
        <div>
          <label class={labelCls} for="qr-margin">留白</label>
          <input id="qr-margin" type="number" min="0" max="10" value="2" class={inputCls} />
        </div>
        <div>
          <label class={labelCls} for="qr-level">容错</label>
          <select id="qr-level" class={inputCls}>
            <option value="L">L</option>
            <option value="M" selected>M</option>
            <option value="Q">Q</option>
            <option value="H">H</option>
          </select>
        </div>
      </div>
      <div class="flex gap-3">
        <button id="qr-gen" class="rounded-lg bg-emerald-600 px-4 py-2 text-sm font-medium text-white hover:bg-emerald-500">
          生成
        </button>
        <button id="qr-download" class="rounded-lg border border-slate-300 px-4 py-2 text-sm hover:bg-slate-100 dark:border-slate-700 dark:hover:bg-slate-800">
          下载 PNG
        </button>
      </div>
      <p id="qr-status" class="text-sm text-slate-500 dark:text-slate-400"></p>
    </div>
    <div class="flex items-start justify-center">
      <canvas id="qr-canvas" class="rounded-xl border border-slate-300/70 dark:border-slate-700"></canvas>
    </div>
  </div>
</ToolShell>

<script>
  import QRCode from "qrcode";

  const text = document.getElementById("qr-text") as HTMLTextAreaElement;
  const size = document.getElementById("qr-size") as HTMLInputElement;
  const margin = document.getElementById("qr-margin") as HTMLInputElement;
  const level = document.getElementById("qr-level") as HTMLSelectElement;
  const canvas = document.getElementById("qr-canvas") as HTMLCanvasElement;
  const status = document.getElementById("qr-status")!;

  async function generate() {
    if (!text.value) {
      status.textContent = "请输入内容";
      status.className = "text-sm text-red-600 dark:text-red-400";
      return;
    }
    try {
      await QRCode.toCanvas(canvas, text.value, {
        width: Math.min(1024, Math.max(128, Number(size.value) || 256)),
        margin: Math.min(10, Math.max(0, Number(margin.value) || 0)),
        errorCorrectionLevel: level.value as "L" | "M" | "Q" | "H",
        color: { dark: "#0f172a", light: "#ffffff" },
      });
      status.textContent = "生成成功 ✓";
      status.className = "text-sm text-emerald-600 dark:text-emerald-400";
    } catch (e) {
      status.textContent = `生成失败：${(e as Error).message}`;
      status.className = "text-sm text-red-600 dark:text-red-400";
    }
  }

  document.getElementById("qr-gen")?.addEventListener("click", generate);

  document.getElementById("qr-download")?.addEventListener("click", () => {
    const link = document.createElement("a");
    link.download = "qrcode.png";
    link.href = canvas.toDataURL("image/png");
    link.click();
  });

  let timer: number | undefined;
  text.addEventListener("input", () => {
    window.clearTimeout(timer);
    timer = window.setTimeout(generate, 300);
  });
  size.addEventListener("input", generate);
  margin.addEventListener("input", generate);
  level.addEventListener("change", generate);

  generate();
</script>
