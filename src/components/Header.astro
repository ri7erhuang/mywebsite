---
import { NAV_ITEMS, SITE } from "../consts";

const current = Astro.url.pathname;

function isActive(href: string) {
  if (href === "/") return current === "/";
  return current === href || current.startsWith(`${href}/`);
}
---

<header
  class="sticky top-0 z-40 border-b border-slate-300/70 bg-paper/85 backdrop-blur dark:border-slate-800 dark:bg-ink/80"
>
  <nav class="mx-auto flex h-14 max-w-4xl items-center gap-6 px-4">
    <a
      href="/"
      class="shrink-0 font-mono text-sm font-semibold tracking-tight text-slate-900 dark:text-slate-100"
    >
      <span class="text-emerald-600 dark:text-emerald-400">$</span> {SITE.title}
    </a>
    <ul class="hidden flex-1 items-center gap-1 font-mono text-[0.8rem] sm:flex">
      {
        NAV_ITEMS.map((item) => (
          <li>
            <a
              href={item.href}
              class:list={[
                "rounded-md px-3 py-1.5 transition-colors",
                isActive(item.href)
                  ? "bg-slate-900/[0.06] text-emerald-700 dark:bg-white/10 dark:text-emerald-300"
                  : "text-slate-500 hover:text-slate-900 dark:text-slate-400 dark:hover:text-white",
              ]}
            >
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
    <div class="ml-auto flex shrink-0 items-center">
      <button
        id="theme-toggle"
        type="button"
        aria-label="切换主题"
        class="rounded-md p-2 text-slate-600 hover:bg-slate-900/[0.06] dark:text-slate-400 dark:hover:bg-white/10"
      >
        <svg class="h-5 w-5 dark:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79Z" />
        </svg>
        <svg class="hidden h-5 w-5 dark:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="12" cy="12" r="4" />
          <path stroke-linecap="round" d="M12 2v2m0 16v2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4M2 12h2m16 0h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
        </svg>
      </button>
      <button
        id="nav-open"
        type="button"
        aria-label="打开导航菜单"
        aria-controls="nav-drawer"
        aria-expanded="false"
        class="rounded-md p-2 text-slate-600 hover:bg-slate-900/[0.06] dark:text-slate-400 dark:hover:bg-white/10 sm:hidden"
      >
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" d="M4 7h16M4 12h16M4 17h16" />
        </svg>
      </button>
    </div>
  </nav>
</header>

<div
  id="nav-backdrop"
  class="pointer-events-none fixed inset-0 z-[45] bg-black/50 opacity-0 transition-opacity duration-300 sm:hidden"
></div>
<aside
  id="nav-drawer"
  inert
  aria-hidden="true"
  class="fixed inset-y-0 left-0 z-50 flex w-1/2 min-w-[200px] max-w-xs -translate-x-full flex-col border-r border-slate-300/70 bg-paper transition-transform duration-300 ease-out dark:border-slate-800 dark:bg-ink sm:hidden"
>
  <div
    class="flex h-14 shrink-0 items-center justify-between border-b border-slate-300/70 px-4 dark:border-slate-800"
  >
    <span class="font-mono text-sm text-slate-500 dark:text-slate-400">$ nav</span>
    <button
      id="nav-close"
      type="button"
      aria-label="关闭导航菜单"
      class="rounded-md p-2 text-slate-600 hover:bg-slate-900/[0.06] dark:text-slate-400 dark:hover:bg-white/10"
    >
      <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" d="M6 6l12 12M18 6L6 18" />
      </svg>
    </button>
  </div>
  <ul class="flex-1 space-y-1 overflow-y-auto p-3 font-mono text-base">
    {
      NAV_ITEMS.map((item) => (
        <li>
          <a
            href={item.href}
            class:list={[
              "flex items-center gap-3 rounded-md px-3 py-3 transition-colors",
              isActive(item.href)
                ? "bg-slate-900/[0.06] text-emerald-700 dark:bg-white/10 dark:text-emerald-300"
                : "text-slate-600 hover:bg-slate-900/[0.04] dark:text-slate-300 dark:hover:bg-white/5",
            ]}
          >
            <span class="text-emerald-600 dark:text-emerald-400">›</span>
            {item.label}
          </a>
        </li>
      ))
    }
  </ul>
</aside>

<script>
  const toggle = document.getElementById("theme-toggle");
  toggle?.addEventListener("click", () => {
    const isDark = document.documentElement.classList.toggle("dark");
    localStorage.setItem("theme", isDark ? "dark" : "light");
  });

  const drawer = document.getElementById("nav-drawer");
  const backdrop = document.getElementById("nav-backdrop");
  const openBtn = document.getElementById("nav-open");
  const closeBtn = document.getElementById("nav-close");

  function setDrawer(open: boolean) {
    if (!drawer || !backdrop || !openBtn) return;
    drawer.style.translate = open ? "0 0" : "-100% 0";
    drawer.toggleAttribute("inert", !open);
    drawer.setAttribute("aria-hidden", String(!open));
    backdrop.classList.toggle("opacity-100", open);
    backdrop.classList.toggle("pointer-events-auto", open);
    backdrop.classList.toggle("opacity-0", !open);
    backdrop.classList.toggle("pointer-events-none", !open);
    openBtn.setAttribute("aria-expanded", String(open));
    document.documentElement.classList.toggle("overflow-hidden", open);
  }

  openBtn?.addEventListener("click", () => setDrawer(true));
  closeBtn?.addEventListener("click", () => setDrawer(false));
  backdrop?.addEventListener("click", () => setDrawer(false));
  drawer?.querySelectorAll("a").forEach((a) =>
    a.addEventListener("click", () => setDrawer(false)),
  );
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") setDrawer(false);
  });
</script>
